# ==============================================================================
# PeerLearn Environment Configuration (SPEC_V2 Section 6: local, staging, prod)
# Rule R7: Secret service role keys are ONLY placed in server env vars / Edge Functions.
# Never expose secrets to client-facing web environment variables!
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3001

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-public-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-secret... # R7: Server only!

# Africa's Talking Telecom API (SMS & USSD)
AFRICAS_TALKING_USERNAME=sandbox # or your production Africa's Talking app name
AFRICAS_TALKING_API_KEY=atsk_...your-africas-talking-api-key...
AFRICAS_TALKING_SHORT_CODE=384500 # e.g. *384*500#
AFRICAS_TALKING_SENDER_ID=PeerLearn

# Frontend Environment Variables (Vite PWA)
VITE_API_BASE_URL=https://api.peerlearn.ac.ke
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-public-anon-key...
