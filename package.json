{
  "name": "peerlearn",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"blue,green\" \"npm run dev --workspace server\" \"npm run dev --workspace web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
    "seed:cloud": "tsx server/src/scripts/seed-cloud-db.ts",
    "seed:dry-run": "tsx server/src/scripts/seed-cloud-db.ts --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "vitest": "^5.0.5"
  }
}
